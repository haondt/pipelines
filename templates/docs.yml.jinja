stages:
  - build
  - deploy

{% for source in task.sources %}

{% if source.type == 'python' or source.type == 'mkdocs' %}
mkdocs-docs-build-{{ source.subpath }}-{{ source.ref }}:
  stage: build
  image: {{ images.docs }}
  script:
    - INITIAL_DIR=$(pwd)
    {% if source.subpath %}
    - |
      if [ -d public/{{ source.subpath }} ]; then
          echo "using cached artifact"
          exit 0
      fi
    {% endif %}
    {% if source.repository %}
    - git clone {{ source.repository }} target
    - cd target
    - git checkout {{ source.ref }}
    {% endif %}
    - cd {{ source.context|default('.') }}
{% for package in source.install|default([]) %}
    - pip install {{ package }}
{% endfor %}
    {% if source.subpath %}
    - mkdocs build -c -d $INITIAL_DIR/public/{{ source.subpath }}
    {% else %}
    - mkdocs build -c -d $INITIAL_DIR/public
    {% endif %}
  artifacts:
    paths:
      {% if source.subpath %}
      - public/{{ source.subpath }}
      {% else %}
      - public/
      {% endif %}
  {% if source.subpath and source.repository %}
  cache:
    key: "python-docs-build-{{ source.subpath }}-{{ source.ref }}"
    paths:
      - public/{{ source.subpath }}
  {% endif %}

{% elif source.type == 'pelican' %}
pelican-docs-build-{{ source.subpath }}-{{ source.ref }}:
  stage: build
  image: {{ images.docs }}
  script:
    - INITIAL_DIR=$(pwd)
    {% if source.subpath %}
    - |
      if [ -d public/{{ source.subpath }} ]; then
          echo "using cached artifact"
          exit 0
      fi
    {% endif %}
    {% if source.repository %}
    - git clone {{ source.repository }} target
    - cd target
    - git checkout {{ source.ref }}
    {% endif %}
    - cd {{ source.context|default('.') }}
{% for package in source.install|default([]) %}
    - pip install {{ package }}
{% endfor %}
    {% if source.subpath %}
    - pelican {{ source.path|default('.') }} -o $INITIAL_DIR/public/{{ source.subpath }} -s {{ source.publishconf|default('publishconf.py') }}
    {% else %}
    - pelican {{ source.path|default('.') }} -o $INITIAL_DIR/public -s {{ source.publishconf|default('publishconf.py') }}
    {% endif %}
  artifacts:
    paths:
      {% if source.subpath %}
      - public/{{ source.subpath }}
      {% else %}
      - public/
      {% endif %}
  {% if source.subpath and source.repository %}
  cache:
    key: "python-docs-build-{{ source.subpath }}-{{ source.ref }}"
    paths:
      - public/{{ source.subpath }}
  {% endif %}

{% elif source.type == 'copy' %}
copy-docs-build-{{ source.subpath }}-{{ source.ref }}:
  stage: build
  image: {{ images.docs }}
  script:
    - INITIAL_DIR=$(pwd)
    {% if source.repository %}
    - git clone {{ source.repository }} target
    - cd target
    - git checkout {{ source.ref }}
    {% endif %}
    - cd {{ source.context|default('.') }}
    {% if source.subpath %}
    - mkdir -p $INITIAL_DIR/public/{{ source.subpath }}
    - cp -r {{ source.path|default('.') }}/. $INITIAL_DIR/public/{{ source.subpath }}/
    {% else %}
    - mkdir -p $INITIAL_DIR/public
    - cp -r {{ source.path|default('.') }}/. $INITIAL_DIR/public/
    {% endif %}
  artifacts:
    paths:
      {% if source.subpath %}
      - public/{{ source.subpath }}
      {% else %}
      - public/
      {% endif %}
  {% if source.subpath and source.repository %}
  cache:
    key: "copy-docs-build-{{ source.subpath }}-{{ source.ref }}"
    paths:
      - public/{{ source.subpath }}
  {% endif %}
{% endif %}

{% endfor %}

{% for target in task.targets %}

{% if target.type == "gitlab-pages" %}
gitlab-pages:
  pages: true
{% elif target.type == "cloudflare-pages" %}
cloudflare-pages-{{ target.project }}:
  environment:
    name: {{ target.environment or ("cloudflare/" ~ target.project) }}
{% endif %}
  stage: deploy
  needs:

{% for source in task.sources %}

{% if source.type == 'python' or source.type == 'mkdocs' %}
    - mkdocs-docs-build-{{ source.subpath }}-{{ source.ref }}
{% elif source.type == 'pelican' %}
    - pelican-docs-build-{{ source.subpath }}-{{ source.ref }}
{% elif source.type == 'copy' %}
    - copy-docs-build-{{ source.subpath }}-{{ source.ref }}
{% endif %}

{% endfor %}


{% if target.type == "gitlab-pages" %}
  script:
    - echo "noop"
  artifacts:
    paths:
      - public
{% elif target.type == "cloudflare-pages" %}
{# needs $CLOUDFLARE_ACCOUNT_ID and $CLOUDFLARE_API_TOKEN #}
  script:
    - wrangler pages deploy public --project-name={{ target.project }}
{% else %}
  script:
    - echo "noop"
{% endif %}


{% endfor %}
